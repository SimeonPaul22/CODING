# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vtudex?schema=public"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# VTpass (https://sandbox.vtpass.com -> Profile -> API Keys)
VTPASS_BASE_URL="https://sandbox.vtpass.com/api"
VTPASS_API_KEY="xxxxxxxxxxxxxxxxxxxx"
VTPASS_PUBLIC_KEY="PK_xxxxxxxxxxxxxxxxxxxx"
VTPASS_SECRET_KEY="SK_xxxxxxxxxxxxxxxxxxxx"

# Termii (optional — SMS is mocked when empty)
TERMII_API_KEY=""
