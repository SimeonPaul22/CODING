# Copy this file to .env and fill in what you need. Never commit .env.
# Paper and backtest modes need NO exchange keys.

# --- Exchange API (only for live mode) ---------------------------------------
# Create a key with READ + SPOT TRADE permissions only. NEVER enable withdrawals.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Bitget and KuCoin also require the passphrase you set when creating the key.
EXCHANGE_API_PASSWORD=

# --- Anthropic (Claude) --------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram alerts (optional) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Non-interactive live confirmation ----------------------------------------
# When the bot runs without a terminal (systemd), it cannot show the live
# confirmation prompt. Set this exact value to confirm live trading instead.
# Leave it empty while you are testing.
CONFIRM_LIVE_TRADING=
